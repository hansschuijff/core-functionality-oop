{
    "name": "dewitteprins/core-functionality",
    "description": "Central Microkernel framework for De Witte Prins",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
   "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php",
            "src/legacy.php"
        ],
        "psr-4": {
            "DeWittePrins\\CoreFunctionality\\": "src/"
        }
    }
}
