<?xml version="1.0"?>
<ruleset name="DeWittePrins WordPress Code Standards">
    <description>Strict compliance ruleset for remote tickets blocks plugin development.</description>

    <!-- Exclude third-party assets and compressed build folders -->
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <!-- Enforce the official WordPress Core standards -->
    <rule ref="WordPress-Core" />
    <rule ref="WordPress-Docs" />

    <!-- Check all PHP files inside these core repositories -->
    <file>src/</file>
    <file>config/</file>
    <file>core-functionality.php</file>
</ruleset>
